# Firebase Web App configuration (client-side).
# Copy this file to `.env` and replace the placeholder values with the config
# from your Firebase project: Project settings -> General -> Your apps -> SDK setup.
# All variables MUST be prefixed with VITE_ to be exposed to the Vite client build.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
